# ── Guardrails backend ────────────────────────────────────────────────────────
# Select OpenGuardrails as the active guardrails backend.
# Options: "openguardrails" | "model_armor" | "none"
GUARDRAILS_BACKEND=openguardrails

# ── OpenGuardrails ────────────────────────────────────────────────────────────
# Your OpenGuardrails API key (required when GUARDRAILS_BACKEND=openguardrails)
OPENGUARDRAILS_API_KEY=your-openguardrails-api-key

# Connection settings — these can also be set in filter_config.yaml instead.
# Leave unset to use the values from filter_config.yaml (recommended).
# OPENGUARDRAILS_BASE_URL=https://api.openguardrails.com/v1
# OPENGUARDRAILS_TIMEOUT=30
# OPENGUARDRAILS_MAX_RETRIES=3
