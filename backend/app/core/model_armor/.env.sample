# ── Guardrails backend ────────────────────────────────────────────────────────
# Select Model Armor as the active guardrails backend.
# Options: "model_armor" | "none"
GUARDRAILS_BACKEND=model_armor

# ── Google Cloud / Model Armor ────────────────────────────────────────────────
# Your Google Cloud Project ID
GCP_PROJECT_ID=your-gcp-project-id

# GCP region where the Model Armor API is available (e.g. us-central1)
GCP_LOCATION=us-central1

# Unique identifier for the Model Armor filtering template
MODEL_ARMOR_TEMPLATE_ID=your-template-id

# ── Optional: explicit service-account credentials ────────────────────────────
# Leave unset to use Application Default Credentials (recommended).
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
