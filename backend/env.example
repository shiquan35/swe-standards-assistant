ENVIRONMENT=development
DB_FULL_CONNECTION_STRING=
LANGTRACE_API_KEY= # leave empty
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# User-selected generation model; live model/account compatibility is unverified.
# Set OPENAI_CHAT_MODEL yourself in your local ignored configuration if needed.
OPENAI_CHAT_MODEL=gpt-6-luna
RAG_MAX_INPUT_TOKENS=32000
RAG_MAX_OUTPUT_TOKENS=4096
RAG_TOKEN_SAFETY_MARGIN=.20
# Operator-configured context window, not a verified provider/model capability.
RAG_MODEL_CONTEXT_WINDOW=1050000
# Unknown model mapping uses o200k_base: explicitly unverified estimation only.
# Estimate = ceil((complete JSON request/schema tokens + framing 256) * 1.2)
# with the default margin. Estimates do not guarantee provider token limits.
# RUN_LIVE_RAG_TEST=1 opts into paid tests; intentionally not enabled here.